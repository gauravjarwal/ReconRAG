ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- API authentication (X-API-Key header) ---
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEYS: normal access; PHI comes back pseudonymized.
# PHI_ACCESS_API_KEYS: may also request re-identified answers ("reidentify": true).
API_KEYS=replace_with_generated_key
PHI_ACCESS_API_KEYS=
# Key the Streamlit frontend uses. Must appear in API_KEYS or PHI_ACCESS_API_KEYS.
FRONTEND_API_KEY=replace_with_generated_key

# --- PHI protection ---
# HMAC key for pseudonym tokens (>= 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PHI_HMAC_KEY=replace_with_generated_secret
# Fernet key encrypting the PHI vault:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHI_ENCRYPTION_KEY=replace_with_generated_fernet_key
# Rotating either key orphans existing tokens: re-ingest collections after rotation.

# Set to 1 only behind an intercepting corporate proxy, never with real PHI.
# DISABLE_SSL_VERIFY=1
